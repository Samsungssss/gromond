{
  "name": "saleor-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "dev:webpack": "next dev --webpack -p 3000 -H 0.0.0.0",
    "dev:theme-editorial": "NEXT_PUBLIC_TYPOGRAPHY_THEME=editorial next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "predev": "npm run generate:all",
    "prebuild": "npm run generate:all",
    "pretypecheck": "npm run generate:all",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:design-tokens": "node scripts/check-design-tokens.mjs",
    "lint:graphql-variants": "node scripts/check-deprecated-product-variants.mjs",
    "generate": "graphql-codegen --config .graphqlrc.ts",
    "generate:checkout": "graphql-codegen --config src/checkout/graphql/codegen.ts",
    "generate:all": "npm run generate && npm run generate:checkout",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:instant": "playwright test e2e/instant-navigation.spec.ts",
    "test:e2e:checkout": "playwright test e2e/checkout-step-back.spec.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run docs:check && npm run lint:design-tokens && npm run lint:graphql-variants && npm run typecheck && npm run lint && npm run test:run",
    "verify:quick": "npm run lint:design-tokens && npm run typecheck",
    "docs:check": "node skills/saleor-paper-storefront/scripts/ensure-rule-frontmatter.mjs --check && node skills/saleor-paper-storefront/scripts/compile-agents.mjs --check",
    "docs:compile": "node skills/saleor-paper-storefront/scripts/ensure-rule-frontmatter.mjs && node skills/saleor-paper-storefront/scripts/compile-agents.mjs",
    "doctor": "node scripts/paper-doctor.mjs",
    "doctor:check": "node scripts/paper-doctor.mjs --check",
    "knip": "knip",
    "configurator:storefront-content:validate": "npx @saleor/configurator validate --config config/saleor/storefront-content.config.yml",
    "configurator:storefront-content:plan": "sh scripts/configurator-storefront-content.sh plan",
    "configurator:storefront-content:deploy": "sh scripts/configurator-storefront-content.sh deploy",
    "configurator:storefront-content:drop": "node scripts/drop-storefront-models.mjs",
    "configurator:storefront-content:translations": "node scripts/deploy-storefront-translations.mjs",
    "configurator:storefront-content:reset": "node scripts/drop-storefront-models.mjs && sh scripts/configurator-storefront-content.sh deploy && sh scripts/configurator-storefront-content.sh deploy && node scripts/deploy-storefront-translations.mjs",
    "catalog:translations:fetch": "node scripts/fetch-catalog-translations.mjs",
    "catalog:translations:plan": "node scripts/deploy-catalog-translations.mjs --dry-run --fail-on-skip",
    "catalog:translations:deploy": "node scripts/deploy-catalog-translations.mjs --fail-on-skip",
    "content:verify-attribute-slugs": "node scripts/verify-storefront-attribute-slugs.mjs",
    "content:verify-seed": "vitest run src/lib/content/configurator-seed.sync.test.ts",
    "content:export-seed": "node scripts/export-storefront-content-seed.mjs",
    "orders:seed": "node scripts/seed-paid-orders.mjs",
    "skills:bootstrap": "node scripts/bootstrap-agent-skills.mjs",
    "har:analyze": "node scripts/analyze-storefront-har.mjs"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "3.2.0",
    "@radix-ui/react-dialog": "1.1.17",
    "@radix-ui/react-dropdown-menu": "2.1.18",
    "@radix-ui/react-navigation-menu": "1.2.16",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@saleor/auth-sdk": "1.0.3",
    "@stripe/react-stripe-js": "6.6.0",
    "@stripe/stripe-js": "9.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "editorjs-html": "3.4.3",
    "embla-carousel-react": "8.6.0",
    "geist": "1.7.2",
    "graphql": "16.8.1",
    "graphql-tag": "2.12.7",
    "lodash-es": "4.18.1",
    "lucide-react": "0.358.0",
    "next": "16.3.4",
    "next-intl": "4.13.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "4.0.13",
    "react-zoom-pan-pinch": "4.0.3",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "1.0.7",
    "ts-invariant": "0.10.3",
    "urql": "4.0.6",
    "xss": "1.0.15"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "6.1.1",
    "@graphql-codegen/client-preset": "5.2.2",
    "@graphql-codegen/typescript": "5.0.7",
    "@graphql-codegen/typescript-operations": "5.0.7",
    "@graphql-codegen/typescript-urql": "4.0.1",
    "@graphql-eslint/eslint-plugin": "4.4.0",
    "@next/env": "16.3.4",
    "@next/playwright": "16.3.4",
    "@parcel/watcher": "2.5.6",
    "@playwright/test": "1.55.0",
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "0.5.20",
    "@types/lodash-es": "4.17.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.5.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.7",
    "husky": "8.0.3",
    "knip": "5.41.1",
    "lint-staged": "15.1.0",
    "postcss": "8.5.6",
    "postcss-import": "16.1.1",
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "0.5.9",
    "schema-dts": "1.1.2",
    "tailwindcss": "3.4.19",
    "typescript": "5.3.3",
    "vitest": "4.1.9",
    "yaml": "2.9.0"
  },
  "overrides": {
    "graphql": "16.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}