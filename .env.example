# Required: Saleor API endpoint (must end in /graphql/)
NEXT_PUBLIC_SALEOR_API_URL=https://your-instance.saleor.cloud/graphql/

# Required: Default channel slug in your Saleor instance (e.g. default-channel)
NEXT_PUBLIC_DEFAULT_CHANNEL=default-channel

# Optional: Storefront base URL (e.g. https://your-store.vercel.app)
NEXT_PUBLIC_STOREFRONT_URL=

# Optional: Locale configuration (defaults: en)
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_STOREFRONT_LOCALES=en

# Optional: Multi-channel configuration (comma-separated slugs)
STOREFRONT_CHANNELS=

# Optional: Content provider ('saleor' for Saleor Models CMS or 'code' for code defaults)
CONTENT_PROVIDER=saleor

# Optional: Webhook revalidation secret for cache invalidation
REVALIDATE_SECRET=
SALEOR_WEBHOOK_SECRET=

# Optional: App token for server-side authenticated operations
SALEOR_APP_TOKEN=

# Optional: Allowed remote image domains (comma-separated)
IMAGE_ALLOWED_HOSTS=